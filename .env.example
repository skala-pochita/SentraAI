# 복사해서 사용: cp .env.example .env
# DB·Redis·Kafka·MCP·대상 에이전트 주소와 WORKSPACE_DIR 은 docker-compose.yml·Dockerfile 이 직접 넣는다.
# 로컬(컨테이너 밖) 실행 시에는 backend/core/settings.py 의 localhost 기본값을 쓴다. 여기에 적을 필요 없다.

# ============================================================
# 필수 — 반드시 바꿀 것 (기본값은 개발용 자리 표시자)
# ============================================================
JWT_SECRET=change-me-32bytes-or-more-xxxxxxxx   # 32바이트 이상 임의 문자열 (예: openssl rand -hex 32)
MCP_SERVICE_TOKEN=change-me                     # API·워커 → business/rag-mcp 서비스 토큰

# ============================================================
# 선택 — 비워 두면 기본값 또는 오프라인 모드로 동작
# ============================================================
# LLM: 키가 없으면 LLM 노드를 건너뛰고 정적 규칙 결과로 진행, 임베딩은 해시 방식(검색 품질 낮음)
OPENAI_API_KEY=
LLM_SMALL_MODEL=gpt-5.4-nano          # 키를 넣으면 실제 호출 가능한 모델 ID 로 확인
EMBEDDING_MODEL=text-embedding-3-small
LANGSMITH_API_KEY=                    # 넣으면 LangSmith 트레이싱

# 토큰 수명
ACCESS_TOKEN_MIN=15
REFRESH_TOKEN_DAYS=7

# 시드 계정 비밀번호 (make seed, 데모용 — 운영 금지)
SEED_ADMIN_PASSWORD=Admin!demo1234
SEED_DEV_PASSWORD=Dev!demo1234
SEED_AUDITOR_PASSWORD=Auditor!demo1234

# 데모
AGENT_VARIANT=vuln                    # 감사 대상 에이전트: vuln | hardened (make demo-reset 시 반영)
PROBE_ATTEMPTS=3                      # 인젝션 probe 반복 횟수
FAULT_INJECTION=                      # make fault-on/off 가 이 줄을 고친다 — 줄 자체를 지우지 말 것

# Optional dedicated execution server. HTTPS is required for a remote host.
SANDBOX_URL=http://sandbox-runner:8300
SANDBOX_SERVICE_TOKEN=
# Use https://<audit-service>/llm/v1 for a remote executor's fixed LLM relay.
LLM_PROXY_URL=http://llm-proxy:8400/v1
LLM_PROXY_MODEL_ALLOWLIST=gpt-5.4-nano
